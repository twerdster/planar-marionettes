{
  "name": "puppify-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/*.test.ts",
    "test:browser": "playwright test",
    "check:assets": "node scripts/vendor-vision.mjs --check && node scripts/check-originals.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
